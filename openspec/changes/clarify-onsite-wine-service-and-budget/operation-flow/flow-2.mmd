flowchart TD
    A["驗齡及必要姓名核對通過"] --> B["先看原備酒完整價金與酒商賣方"]
    B --> C{"主人決定？"}
    C -->|"全數購買"| F["保留全數購買明細"]
    C -->|"減量購買"| G["交回授權店員，只調整原酒款購買瓶數"]
    C -->|"全部不買"| D["確認取消；原簽名失效"]
    D --> E["整筆待酒商取回；不向主人加收取回費"]
    E --> Z["酒商確認取回，服務未完成"]
    G --> H{"各列瓶數為整數且未超過原備酒數？"}
    H -->|"否"| I["提示並保留原明細"]
    I --> G
    H -->|"是"| H2{"是否至少購買一瓶？"}
    H2 -->|"否：全部不買"| D
    H2 -->|"是"| J["保存減量明細並重算；舊簽名與舊失敗資格失效"]
    J --> K["主人核對本次購買明細"]
    F --> K
    K --> S{"本次明細有有效手寫簽名？"}
    S -->|"否"| L["簽名確認購買，或清除重簽"]
    L --> S
    S -->|"是"| M["現場模擬支付本次酒款與運送費"]
    M --> N{"付款成功？"}
    N -->|"是"| O["本次購買服務完成；僅實購酒款計10%分潤"]
    N -->|"否"| P["保留同版本簽名與付款失敗紀錄"]
    P --> Q{"下一步？"}
    Q -->|"重試付款"| M
    Q -->|"再減量"| G
    Q -->|"取消購買"| D
    Q -->|"請餐廳代收"| R["交回店員確認本筆代收"]
    R --> V{"店員承接代收？"}
    V -->|"否"| K
    V -->|"是"| T["本次購買服務完成；全額代收帳款，僅實購計10%分潤"]
    T --> U["獲選酒商之後確認整筆收清"]
    U --> W["原成交與分潤不變，不重複記帳"]
    O --> X{"本次是否有未購買酒品？"}
    T --> X
    X -->|"否：全數購買"| Y["完成，無餘酒取回待辦"]
    X -->|"是：減量購買"| AA["已購買部分完成；未購買部分依第三圖取回"]
